{
  "name": "dsh-prompt-suggest",
  "version": "0.0.1",
  "description": "Inline next-message prediction in the DSH composer: a grey ghost line, Tab to accept, ArrowUp to recall sent prompts.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.cjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "inline-completion",
    "ghost-text"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linsongrong/dsh-prompt-suggest.git"
  },
  "homepage": "https://github.com/Linsongrong/dsh-prompt-suggest#readme",
  "bugs": {
    "url": "https://github.com/Linsongrong/dsh-prompt-suggest/issues"
  }
}
